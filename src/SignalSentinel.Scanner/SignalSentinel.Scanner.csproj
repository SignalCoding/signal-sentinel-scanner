<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>SignalSentinel.Scanner</PackageId>
    <!-- Version comes from Directory.Build.props (single source of truth). -->
    <Description>Fast, deterministic, offline-capable first-pass security aid for MCP servers and Agent Skill authors. 47 security rules aligned with OWASP Agentic AI Top 10 (ASI) and OWASP Agentic Skills Top 10 (AST). v3.0 adds prompt/resource/instructions injection coverage, skill forensics (SHA256SUMS, file artefacts), homoglyph and description-overlap detection, fetch-to-exec pipeline taint, opt-in OSV dependency lookups, error-channel injection, server-source sink analysis, A2A agent card evaluation, policy presets, a versioned scoring rubric (--rubric), markdown-aware segmentation for skill rules, and discovery across Claude Code, Gemini CLI, OpenCode, VS Code/Copilot and Amazon Q configurations.</Description>
    <PackageTags>mcp;security;scanner;ai-agents;owasp;agentic-ai;cli;dotnet-tool;websocket;agent-skills;skill-scanning;sarif;sigma;suppressions;ast;triage;pre-commit</PackageTags>
    
    <!-- Enable as global dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sentinel-scan</ToolCommandName>
    
    <!-- Assembly info -->
    <AssemblyName>SignalSentinel.Scanner</AssemblyName>
    <RootNamespace>SignalSentinel.Scanner</RootNamespace>
    
    <!-- NuGet Package Configuration -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- <PackageIcon>icon.png</PackageIcon> -->
    <PackageReleaseNotes>See https://github.com/SignalCoding/signal-sentinel-scanner/releases/tag/v$(Version) and CHANGELOG.md</PackageReleaseNotes>
    
    <!-- SourceLink for debugging support -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Security: Generate SBOM for supply chain transparency -->
    <EnableSbomGeneration>true</EnableSbomGeneration>
    
    <!-- Security: Detect unsafe usages -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    
    <!-- Security: Invariant globalization disabled for UK PII pattern matching -->
    <InvariantGlobalization>false</InvariantGlobalization>
    
    <!-- Package validation -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignalSentinel.Core\SignalSentinel.Core.csproj" />
  </ItemGroup>

  <!-- v3.0.0 (WP10): Markdown AST for document segmentation. Apache-2.0.
       0.38.0 released January 2025 - well past the 14-day supply-chain quarantine. -->
  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.38.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SignalSentinel.Scanner.Tests" />
  </ItemGroup>

  <!-- SourceLink for GitHub -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Security Analyzers -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Package content -->
  <ItemGroup>
    <Content Include="DefaultRules.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Policy\Presets\*.json" />
    <EmbeddedResource Include="Scoring\scoring-rubric-v2.0.0.json" />
  </ItemGroup>
  
  <!-- NuGet package assets -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <!-- Package icon (add when available) -->
  <!-- <ItemGroup Condition="Exists('..\..\assets\icon.png')">
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup> -->

</Project>
