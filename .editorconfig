# v2.8.0 repo-standards. Line endings and trailing whitespace are deliberately NOT set here:
# .gitattributes owns EOL policy (stack rule, findings 4.4 - two authorities produced a
# 30,000-violation format storm). Scope this file to indentation/charset only.
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets,razor}]
indent_size = 4

[Makefile]
indent_style = tab
